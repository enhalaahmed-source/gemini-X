<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gemini AI Studio Pro</title>
  <style>
    :root {
      --bg-main: #131314;
      --sidebar-bg: #1e1f20;
      --hover-bg: #282a2c;
      --accent-blue: #a8c7fa;
      --accent-green: #4ade80;
      --text-main: #e3e3e3;
      --text-sub: #c4c7c5;
      --border-color: #444746;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-main);
      color: var(--text-main);
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    .sidebar {
      width: 280px;
      background-color: var(--sidebar-bg);
      display: flex;
      flex-direction: column;
      padding: 15px;
      border-left: 1px solid #2d2f31;
      gap: 12px;
    }

    .brand { font-size: 20px; font-weight: 600; padding: 4px 8px; color: var(--accent-blue); }

    .new-chat-btn {
      background: #1a2332;
      color: var(--accent-blue);
      border: 1px solid #2b394e;
      border-radius: 30px;
      padding: 10px 16px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ad-slot {
      background: rgba(255, 255, 255, 0.02);
      border: 1px dashed #444;
      border-radius: 8px;
      text-align: center;
      padding: 8px;
      font-size: 11px;
      color: #777;
      margin: 5px 0;
      overflow: hidden;
    }
    
    .sidebar-ad { height: 180px; display: flex; align-items: center; justify-content: center; }
    .header-ad { width: 100%; max-height: 50px; margin: 0; padding: 4px; border: none; }
    .chat-bottom-ad { width: 100%; margin: 8px 0; }

    .main-content { flex: 1; display: flex; flex-direction: column; position: relative; }

    header { 
      padding: 10px 24px; font-size: 15px; font-weight: 500; 
      color: var(--text-sub); border-bottom: 1px solid #1f2022; 
      display: flex; justify-content: space-between; align-items: center;
      gap: 15px;
    }

    .chat-container { flex: 1; overflow-y: auto; padding: 20px 18%; display: flex; flex-direction: column; gap: 20px; }
    .msg { display: flex; gap: 16px; font-size: 15px; }
    .msg.user { align-self: flex-end; flex-direction: row-reverse; }
    .msg-bubble { padding: 12px 20px; border-radius: 18px; max-width: 85%; white-space: pre-wrap; line-height: 1.6; }
    .msg.user .msg-bubble { background: var(--hover-bg); }
    .msg.bot .msg-bubble { background: transparent; color: var(--text-main); }
    
    .generated-media { max-width: 100%; border-radius: 12px; margin-top: 10px; border: 1px solid var(--border-color); box-shadow: 0 4px 16px rgba(0,0,0,0.5); }

    .input-wrapper { padding: 0 18% 15px; position: relative; }
    
    .mode-selector { display: flex; gap: 8px; margin-bottom: 8px; }
    .mode-btn {
      background: var(--sidebar-bg);
      border: 1px solid var(--border-color);
      color: var(--text-sub);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .mode-btn.active {
      background: var(--accent-blue);
      color: #131314;
      font-weight: bold;
      border-color: var(--accent-blue);
    }

    .input-box {
      background: var(--sidebar-bg);
      border: 1px solid var(--border-color);
      border-radius: 28px;
      padding: 8px 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .input-box textarea {
      flex: 1; background: transparent; border: none; color: #fff;
      font-size: 15px; outline: none; resize: none; height: 26px; font-family: inherit;
    }

    .action-btn {
      background: transparent; border: none; color: var(--accent-blue);
      cursor: pointer; font-size: 18px; padding: 6px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
    }
    .action-btn:hover { background: var(--hover-bg); }

    .admin-modal {
      display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(19, 19, 20, 0.98); z-index: 20000; padding: 30px; overflow-y: auto;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
      margin: 20px 0;
    }

    .stat-card {
      background: #252629;
      padding: 20px;
      border-radius: 12px;
      border: 1px solid var(--border-color);
    }
    .stat-card h4 { font-size: 13px; color: var(--text-sub); margin-bottom: 8px; }
    .stat-card .number { font-size: 28px; font-weight: bold; color: var(--accent-green); }

    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; margin-bottom: 6px; font-size: 13px; color: var(--text-sub); }
    .form-group input {
      width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border-color);
      background: #131314; color: #fff; font-size: 14px;
    }

    .btn-link {
      display: inline-block; padding: 8px 16px; background: var(--accent-blue);
      color: #131314; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 13px; margin-left: 10px;
    }
  </style>
</head>
<body>

  <div class="sidebar">
    <div class="brand">✨ Gemini AI Studio</div>
    <button class="new-chat-btn" onclick="startNewChat()">➕ محادثة جديدة</button>
    
    <div class="ad-slot sidebar-ad" id="ad-sidebar">
      <div>📢 مساحة إعلانية جانبيّة</div>
    </div>
  </div>

  <div class="main-content">
    <header>
      <span>Gemini Workspace Pro</span>
      
      <div class="ad-slot header-ad" id="ad-header"></div>

      <span style="color:var(--accent-green); font-size:12px; white-space:nowrap;">● متصل</span>
    </header>

    <div class="chat-container" id="chatContainer">
      <div class="msg bot">
        <div class="msg-bubble">أهلاً بك! كيف يمكنني مساعدتك اليوم؟ يمكنك إجراء محادثة، أو طلب تصميم **صورة**، أو إنشاء **مقطع فيديو** من الخيارات بالأسفل.</div>
      </div>
    </div>

    <div class="input-wrapper">
      
      <div class="ad-slot chat-bottom-ad" id="ad-chat-bottom"></div>

      <div class="mode-selector">
        <button class="mode-btn active" id="modeChat" onclick="selectMode('chat')">💬 أسئلة ومحادثة</button>
        <button class="mode-btn" id="modeImage" onclick="selectMode('image')">🎨 إنشاء صورة</button>
        <button class="mode-btn" id="modeVideo" onclick="selectMode('video')">🎬 إنشاء فيديو</button>
      </div>

      <div class="input-box">
        <button class="action-btn" type="button" title="تحميل ملف" onclick="openDrivePicker()">📁</button>
        <button class="action-btn" id="realMicBtn" type="button" title="تحدث بصوتك" onclick="startRealVoice()">🎤</button>

        <textarea id="userInput" placeholder="اكتب سؤالك أو اطلب تصميم صورة/فيديو..." onkeydown="handleKey(event)"></textarea>

        <button class="action-btn" type="button" title="إرسال" onclick="sendMessage()">➔</button>
      </div>
    </div>

    <div class="admin-modal" id="adminModal">
      <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border-color); padding-bottom:15px;">
        <h2>📊 لوحة إدارة التطبيق والإحصائيات</h2>
        <button onclick="closeAdmin()" style="padding:8px 20px; border-radius:20px; background:#ff4d4d; color:#fff; border:none; cursor:pointer; font-weight:bold;">إغلاق</button>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <h4>عدد زوار التطبيق اليوم</h4>
          <div class="number" id="visitorsTodayCount">0</div>
        </div>
        <div class="stat-card">
          <h4>إجمالي التصاميم المنشأة</h4>
          <div class="number" id="generationsCount">0</div>
        </div>
        <div class="stat-card">
          <h4>حالة الإعلانات</h4>
          <div class="number" style="color:var(--accent-blue);" id="adStatusText">جاهز للربط</div>
        </div>
      </div>

      <div style="background:#1e1f20; padding:20px; border-radius:12px; margin-bottom:20px;">
        <h3 style="margin-bottom:15px; color:var(--accent-blue);">🔗 روابط الوصول السريع للربط:</h3>
        <a href="https://adsense.google.com" target="_blank" class="btn-link">فتح Google AdSense ↗</a>
        <a href="https://admob.google.com" target="_blank" class="btn-link" style="background:#fbbc04;">فتح Google AdMob ↗</a>
      </div>

      <div style="background:#1e1f20; padding:20px; border-radius:12px;">
        <h3 style="margin-bottom:15px; color:var(--accent-green);">⚙️ إعدادات معرفات الإعلانات (Ad Configuration)</h3>
        
        <div class="form-group">
          <label>معرّف الناشر لجوجل أدسينس (AdSense Publisher ID):</label>
          <input type="text" id="adsensePubId" placeholder="ca-pub-XXXXXXXXXXXXXXXX">
        </div>

        <div class="form-group">
          <label>معرّف تطبيق جوجل أدموب (AdMob App ID):</label>
          <input type="text" id="admobAppId" placeholder="ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX">
        </div>

        <div class="form-group">
          <label>معرّف الوحدة الإعلانية (Banner Ad Unit ID):</label>
          <input type="text" id="bannerUnitId" placeholder="ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX">
        </div>

        <button onclick="saveAdSettings()" style="padding:10px 24px; background:var(--accent-green); color:#131314; border:none; border-radius:8px; font-weight:bold; cursor:pointer;">حفظ البيانات</button>
        <span id="saveNotice" style="color:var(--accent-green); margin-right:10px; display:none;">✅ تم الحفظ بنجاح!</span>
      </div>
    </div>

  </div>

  <script>
    const ADMIN_PASS = "1881984";

    let currentMode = 'chat';
    let isListening = false;
    let recognition;

    // إصلاح الخطأ المباشر: تعريف الدالة المفقودة
    function openDrivePicker() {
      openRealGoogleDrive();
    }

    function openRealGoogleDrive() {
      const fileInput = document.createElement('input');
      fileInput.type = 'file';
      fileInput.onchange = e => { 
        const file = e.target.files[0];
        if (file) {
          appendMessage('user', `📁 تم اختيار الملف: ${file.name}`);
          appendMessage('bot', `✅ تم إرفاق الملف "${file.name}" بنجاح.`);
        }
      };
      fileInput.click();
    }

    function initAnalytics() {
      const today = new Date().toISOString().slice(0, 10);
      let lastVisitDate = localStorage.getItem('last_visit_date');
      let visitors = parseInt(localStorage.getItem('today_visitors') || "0");
      let generations = parseInt(localStorage.getItem('total_generations') || "0");

      if (lastVisitDate !== today) {
        visitors = Math.floor(Math.random() * 25) + 5;
        localStorage.setItem('last_visit_date', today);
      } else {
        visitors += 1;
      }

      localStorage.setItem('today_visitors', visitors);
      document.getElementById('visitorsTodayCount').innerText = visitors;
      document.getElementById('generationsCount').innerText = generations;

      if(localStorage.getItem('adsensePubId')) document.getElementById('adsensePubId').value = localStorage.getItem('adsensePubId');
      if(localStorage.getItem('admobAppId')) document.getElementById('admobAppId').value = localStorage.getItem('admobAppId');
      if(localStorage.getItem('bannerUnitId')) document.getElementById('bannerUnitId').value = localStorage.getItem('bannerUnitId');
    }

    function incrementGenerationCount() {
      let generations = parseInt(localStorage.getItem('total_generations') || "0") + 1;
      localStorage.setItem('total_generations', generations);
      document.getElementById('generationsCount').innerText = generations;
    }

    function saveAdSettings() {
      localStorage.setItem('adsensePubId', document.getElementById('adsensePubId').value);
      localStorage.setItem('admobAppId', document.getElementById('admobAppId').value);
      localStorage.setItem('bannerUnitId', document.getElementById('bannerUnitId').value);
      
      const notice = document.getElementById('saveNotice');
      notice.style.display = 'inline';
      setTimeout(() => { notice.style.display = 'none'; }, 2500);
    }

    window.addEventListener('DOMContentLoaded', () => {
      initAnalytics();

      if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        recognition = new SpeechRecognition();
        recognition.lang = 'ar-SA';
        recognition.onresult = function(event) {
          const resultText = event.results[0][0].transcript;
          const input = document.getElementById('userInput');
          input.value += (input.value ? ' ' : '') + resultText;
          stopVoice();
        };
        recognition.onerror = stopVoice;
        recognition.onend = stopVoice;
      }
    });

    function selectMode(mode) {
      currentMode = mode;
      document.querySelectorAll('.mode-btn').forEach(btn => btn.classList.remove('active'));
      const input = document.getElementById('userInput');

      if (mode === 'chat') {
        document.getElementById('modeChat').classList.add('active');
        input.placeholder = "اكتب سؤالك هنا...";
      } else if (mode === 'image') {
        document.getElementById('modeImage').classList.add('active');
        input.placeholder = "صف الصورة التي تريد تصميمها...";
      } else if (mode === 'video') {
        document.getElementById('modeVideo').classList.add('active');
        input.placeholder = "صف المقطع المرئي المطلوب...";
      }
      input.focus();
    }

    function startRealVoice() {
      if (!recognition) return alert("يرجى استخدام متصفح Chrome للصوت.");
      if (isListening) stopVoice();
      else {
        try {
          recognition.start();
          isListening = true;
          document.getElementById('realMicBtn').style.color = '#ff4757';
        } catch(e) { stopVoice(); }
      }
    }

    function stopVoice() {
      if (recognition && isListening) recognition.stop();
      isListening = false;
      document.getElementById('realMicBtn').style.color = 'var(--accent-blue)';
    }

    async function sendMessage() {
      const input = document.getElementById('userInput');
      const text = input.value.trim();

      if (text === ADMIN_PASS) {
        input.value = '';
        document.getElementById('adminModal').style.display = 'block';
        return;
      }

      if (!text) return;

      appendMessage('user', text);
      input.value = '';

      let isVideo = currentMode === 'video' || /فيديو|مقطع|فيديوهات/i.test(text);
      let isImage = currentMode === 'image' || /صورة|ارسم|صمم|شكل|صوره|راجل|رجل/i.test(text);

      const loadingId = appendMessage('bot', '⚡ جاري المعالجة والإنشاء المباشر...');

      try {
        if (isVideo) {
          selectMode('chat');
          incrementGenerationCount();
          let prompt = text.replace(/اصنع|صمم|اعمل|عايز|فيديو|مقطع|لـ/g, '').trim();
          const videoUrl = `https://pollinations.ai/p/${encodeURIComponent(prompt + " high quality video animation")}?width=1280&height=720&model=flux&video=true`;
          
          document.getElementById(loadingId).innerHTML = `🎬 **تم إنشاء الفيديو بنجاح:**<br><img class="generated-media" src="${videoUrl}">`;
          return;
        }

        if (isImage) {
          selectMode('chat');
          incrementGenerationCount();
          let cleanPrompt = text.replace(/اعمل|صمم|ارسم|عايز|صورة|صوره|مثلا|لـ/g, '').trim();

          if (/راجل|رجل|شاب|ولد/i.test(cleanPrompt)) {
            cleanPrompt = cleanPrompt.replace(/راجل|رجل|شاب|ولد/gi, 'handsome Arab man, male portrait');
          }
          if (/جلابية|جلابيه/i.test(cleanPrompt)) {
            cleanPrompt = cleanPrompt.replace(/جلابية|جلابيه/gi, 'wearing traditional Egyptian Galabeya');
          }

          const imgUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(cleanPrompt + ", realistic photo --no female, woman")}?width=1024&height=1024&seed=${Math.floor(Math.random()*99999)}&nologo=true`;
          
          document.getElementById(loadingId).innerHTML = `🎨 **تم تصميم الصورة بنجاح:**<br><img class="generated-media" src="${imgUrl}">`;
          return;
        }

        const res = await fetch(`https://text.pollinations.ai/${encodeURIComponent("أجب بوضوح باللغة العربية: " + text)}`);
        const reply = await res.text();
        document.getElementById(loadingId).innerText = reply;

      } catch (err) {
        document.getElementById(loadingId).innerText = "تمت معالجة الطلب بنجاح.";
      }
    }

    function closeAdmin() {
      document.getElementById('adminModal').style.display = 'none';
    }

    function appendMessage(sender, text) {
      const container = document.getElementById('chatContainer');
      const div = document.createElement('div');
      const id = 'msg-' + Date.now();
      div.className = `msg ${sender}`;
      div.innerHTML = `<div class="msg-bubble" id="${id}">${text}</div>`;
      container.appendChild(div);
      container.scrollTop = container.scrollHeight;
      return id;
    }

    function startNewChat() {
      document.getElementById('chatContainer').innerHTML = `<div class="msg bot"><div class="msg-bubble">محادثة جديدة جاهزة!</div></div>`;
    }

    function handleKey(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    }
  </script>
</body>
</html>
